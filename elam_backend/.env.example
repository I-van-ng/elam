PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/elam?schema=public

# OBLIGATOIRE (16 caracteres minimum). Il n'y a plus de valeur par defaut dans
# le code : un secret present dans le depot permettrait de forger des jetons.
# Genere-le avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# ==========================================================================
# Paiement Mobile Money — contrat direct Airtel Money + Moov Money
# ==========================================================================

# Fournisseur actif : SANDBOX | AIRTEL_MONEY | MOOV_MONEY
# SANDBOX fonctionne sans identifiants (developpement et tests).
# Il confirme les paiements SANS encaisser d'argent : jamais en production.
PAYMENT_PROVIDER=SANDBOX

# --- Airtel Money (Airtel Open API) ---------------------------------------
# Identifiants fournis avec le contrat marchand Airtel Gabon.
AIRTEL_BASE_URL=https://openapi.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=GA
AIRTEL_CURRENCY=XAF

# --- Moov Money (API marchand Moov Africa) --------------------------------
# L'API Moov est declinee PAR PAYS : recale ces chemins sur la documentation
# que Moov Gabon te remettra. Aucun autre fichier n'est a modifier.
MOOV_BASE_URL=
MOOV_AUTH_PATH=/oauth/token
MOOV_COLLECT_PATH=/api/v1/payments/collect
MOOV_STATUS_PATH=/api/v1/payments/{ref}
MOOV_MERCHANT_CODE=
MOOV_API_KEY=
MOOV_API_SECRET=
MOOV_CURRENCY=XAF

# --- Securite et regles metier --------------------------------------------
# Secret partage servant a verifier la signature des webhooks operateur.
# SANS LUI, AUCUN PAIEMENT NE SERA CONFIRME (les webhooks sont refuses).
PAYMENT_WEBHOOK_SECRET=

# URL publique que les operateurs appellent pour confirmer une transaction.
PAYMENT_CALLBACK_URL=

# Taux de prise en charge CNAMGS, calcule COTE SERVEUR (0.8 = 80 %).
CNAMGS_COVERAGE_RATE=0.8

# Mode simulation : delai avant confirmation automatique, et endpoints de test.
SANDBOX_CONFIRM_AFTER_MS=6000
PAYMENT_SANDBOX_ENABLED=true
