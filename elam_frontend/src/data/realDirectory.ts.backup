const normalizeDistrict = (value: string) =>
  value
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const coordinatesForDistrict = (district: string) => districtCoordinates[normalizeDistrict(district)] || libreville;

