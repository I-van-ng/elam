const pharmacy = (
  id: string,
  name: string,
  phone: string,
  district: string,
  isOnDuty = false,
  extra?: Partial<PharmacyProfile>,
): PharmacyProfile => ({
  id,
  userId: `u-${id}`,
  name,
  address: extra?.address || district,
  city: extra?.city || coordinatesForDistrict(district).city || 'Libreville',
  district,
  latitude: extra?.latitude ?? coordinatesForDistrict(district).latitude,
  longitude: extra?.longitude ?? coordinatesForDistrict(district).longitude,
  positionConfirmed: extra?.positionConfirmed ?? Boolean(extra?.latitude && extra?.longitude),
  phone,
  emergencyPhone: extra?.emergencyPhone,
  openingHours: extra?.openingHours || (isOnDuty ? 'Pharmacie de garde' : 'Horaires à confirmer'),
  isOnDuty,
  acceptsCnamgs: false,
  rating: extra?.rating ?? 5,
  reviewCount: extra?.reviewCount ?? 0,
  verificationStatus: 'VERIFIED',
  distanceKm: extra?.distanceKm,
});

